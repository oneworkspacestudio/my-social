Page Activity
  Stack variant=activity
    Row
      Heading level=2 "A little hello from your people"
      Spacer
      Button action=readAll variant=secondary "Mark all read"
    For each=$events
      Card variant=activity-row
        Icon name=Bell
        Stack gap=xs
          Text $item.label
          Text variant=caption $item.date
        Spacer
        Badge tone=$item.tone $item.status
        Button action=notification item=$item.id variant=secondary "Open"
    If condition=$empty
      Card variant=empty
        Icon name=Heart size=40
        Heading level=2 "You’re all caught up."
        Text "Likes, follows, comments and Story responses will arrive here."
