{
  "manifest_version": 3,
  "name": "My Social Instagram Capture",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Capture accessible Instagram posts from a tab and download ZIP archives for My Social.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Capture Instagram for My Social", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
