Page Shell
  Stack variant=sidebar
    Link href="#home" variant=brand
      Image src=$logo alt="My Social" width=42 height=42
      Stack gap=xs
        Heading level=2 "My Social"
        Text variant=eyebrow "ONE WORKSPACE"
    For each=$nav
      Link href=$item.href variant=$item.variant aria-label=$item.title
        Icon name=$item.icon
        Text $item.title
    Spacer
    Button variant=create action=create
      Icon name=Plus
      Text "Create a moment"
    Link href="#settings" variant=nav
      Icon name=Settings2
      Text "Settings"
    Button variant=icon action=theme aria-label="Toggle color theme"
      Icon name=SunMoon
    If condition=$workspace
      Link href=$workspace variant=workspace-link "← One Workspace"
  Stack variant=$workspaceVariant
    Row variant=topbar
      Link href="#home" variant=mobile-brand "My Social"
      Spacer
      Button variant=icon action=apps aria-label="Open Workspace apps"
        Icon name=Grid2X2
      Link href="#notifications" variant=icon aria-label="Notifications"
        Icon name=Bell
      Link href="#settings" variant=avatar aria-label="Account settings"
        If condition=$avatarURL
          Image src=$avatarURL variant=avatar alt="Your profile photo" width=44 height=44
        Else
          Text $initials
    Stack variant=content
      If condition=$offline
        Alert tone=warning "You’re offline. Device drafts remain available. Publishing needs a connection."
      If condition=$error
        Alert tone=error $error
      If condition=$notice
        Alert tone=success $notice
      If condition=$busy
        Row
          Spinner
          Text $busy
      Section id=screen-outlet
    Text variant=footer $versionText
  Row variant=$bottomVariant
    For each=$mobileNav
      Link href=$item.href variant=$item.variant aria-label=$item.title
        If condition=$item.avatarURL
          Image src=$item.avatarURL variant=nav-avatar alt="Your profile" width=26 height=26
        Else
          Icon name=$item.icon
        Text $item.title
