Page Export
  Stack
    Row
      Image src="icons/48.png" alt="My Social" width=48 height=48
      Stack
        Text variant=eyebrow "INSTAGRAM → YOUR COMPUTER → MY SOCIAL"
        Heading level=1 "Download my Instagram uploads"
    Card
      Heading level=2 "1. Find my photos and videos"
      Text "Keep your own Instagram profile open. This scans its uploads, including carousel photos and videos. Feed, saved, tagged and other accounts’ posts are excluded."
      Field label="My Instagram username"
        Input name=username placeholder="Your Instagram username"
      Text variant=caption $source
      Checkbox name=scroll "Scroll my profile to find older uploads"
      Field label="Maximum scroll steps per grid"
        Select name=scrolls options=$scrollOptions
      Checkbox name=reels "Scan my Reels grid too"
      Checkbox name=enrich "Open each discovered upload to find its photos, videos and carousel slides"
      Text variant=caption "Scanning finds media first. Click Download below to save the actual files. Scanning a large profile can take several minutes; keep this tab open."
      Row
        Button action=capture disabled=$noSource "Scan my uploads"
        If condition=$busy
          Button action=stop cancel=true variant=secondary "Stop"
      If condition=$busy
        Alert $busy
      If condition=$error
        Alert tone=error $error
      If condition=$notice
        Alert $notice
    If condition=$hasPosts
      Card
        Heading level=2 "2. Download my media"
        Text $summary
        Row
          Button action=all variant=secondary "Select all uploads"
          Button action=none variant=secondary "Clear selection"
          Button action=export disabled=$noSelection "Download my media ZIPs"
        Text "Your photos and videos go into Chrome Downloads → MySocial. Unzip a downloaded file and open media/posts/ to see them. Each ZIP also works with My Social’s Instagram importer."
        Text variant=caption "A profile scan is best effort, not proof that every upload is backed up. Incomplete media is marked below. Stories/archives and unavailable uploads need Instagram’s account export. Videos over 90 seconds can be downloaded but cannot be imported unchanged into My Social."
        For each=$posts
          Card variant=post
            If condition=$item.hasPreview
              Image variant=preview src=$item.preview alt="Upload preview"
            Row
              Badge $item.kind
              Text variant=caption $item.owner
              Text variant=caption $item.date
            Text $item.caption
            Text variant=caption $item.details
            If condition=$item.warning
              Alert tone=warning $item.warning
            Link href=$item.permalink external=true "View my upload on Instagram"
            Button action=toggle item=$item.permalink variant=$item.variant aria-pressed=$item.selected $item.label
    If condition=$hasDownloads
      Card
        Heading level=2 "My downloaded photos and videos"
        Text "Saved in Chrome Downloads → MySocial. The real media files are inside each ZIP under media/posts/. Partial recoveries are under capture/incomplete/; capture/report.json lists any failures."
        Button action=reveal variant=secondary "Show downloaded ZIP in folder"
        For each=$downloads
          Text $item.label
    If condition=$hasWarnings
      Card
        Heading level=2 "Missing media and scan notes"
        For each=$warnings
          Text $item.text
    Text variant=caption "Nothing is uploaded by this extension. It uses your open Instagram session and normal pages; no password, cookie or private API export."
